# ConnectSphere Environment Configuration Template
# Copy this file to .env for local development

# ---------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ---------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000

# PostgreSQL Connection String (or sqlite:///./connectsphere.db for local dev)
# Example for hosted PostgreSQL (Render / Neon / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/connectsphere
DATABASE_URL=sqlite:///./connectsphere.db

# Allowed CORS Origins (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ---------------------------------------------------------------------------
# Base URL pointing to the deployed FastAPI backend
# Local: http://localhost:8000
# Production: https://connectsphere-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

